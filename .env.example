# Use ENV:GH_TOKEN with --token. Never commit real credentials.
GH_TOKEN=
GHES_TOKEN=
BB_TOKEN=
BB_CREDS=
DATASCRAPE_LOG_LEVEL=INFO
# Set these to your host UID/GID on Linux so bind-mounted outputs are writable.
DATASCRAPE_UID=1000
DATASCRAPE_GID=1000
GH_APP_ID=
GH_INSTALLATION_ID=
# Prefer mounting the PEM file read-only and pass its container path to --private-key.
GH_APP_PRIVATE_KEY_FILE=/certs/github-app.pem
